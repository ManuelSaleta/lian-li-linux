polkit.addRule(function(action, subject) {
    // The service can only resume an existing root-owned switch journal.
    if (action.id === "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") === "lianli-control-recovery.service" &&
        action.lookup("verb") === "start" && subject.local && subject.active) {
        return polkit.Result.YES;
    }
});
