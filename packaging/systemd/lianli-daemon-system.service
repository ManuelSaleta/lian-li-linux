[Unit]
Description=Lian Li Device Daemon (system service)

[Service]
Type=simple
User=lianli
Group=lianli
RuntimeDirectory=lianli
StateDirectory=lianli
ExecStart=/usr/bin/lianli-daemon --system
Restart=on-failure
RestartSec=5
KillMode=mixed
SendSIGKILL=no
TimeoutStopSec=30s
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
